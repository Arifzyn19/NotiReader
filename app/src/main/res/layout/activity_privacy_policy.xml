<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_charcoal"
    tools:context=".presentation.privacy_policy_screen_activity.PrivacyPolicyActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_background_gradient" />

    <View
        android:id="@+id/glassOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.6"
        android:background="@drawable/enhanced_glass_overlay" />

    <View
        android:id="@+id/ambientGlow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.3"
        android:background="@drawable/ambient_glow_effect" />

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_content_surface"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/warm_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:letterSpacing="0.02"
                android:text="Privacy Policy"
                android:textColor="@color/warm_white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="true"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    android:background="@drawable/glass_info_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="Last Updated"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="September 7, 2025"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="Introduction"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="Tech Nukti Media (&quot;we,&quot; &quot;our,&quot; or &quot;us&quot;) operates the mobile application NotiReader (&quot;App&quot;) available on Android. This Privacy Policy explains how we collect, use, and protect your information when you use our App."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="Information We Collect"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="Our app collects notification data from your device to retrieve deleted WA messages. This includes:"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Message Content"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Sender name"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Timestamps"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We do not access or store your WhatsApp messages directly from the app."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We may collect limited technical information such as:"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Device model and OS version"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• App usage statistics"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Crash logs"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="How We Use Your Information"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We use the collected data to:"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Enable WA message recovery features"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Improve app performance and user experience"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Display personalized or contextual ads"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Monitor app stability and fix bugs"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="In-App Purchases"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="The app offers a premium subscription at ₹349/month, which may remove ads or unlock extra features. All purchases are processed securely via Google Play Billing. We do not store your payment details."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="Data Security"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We take reasonable measures to protect your data. All notification data is processed locally on your device and is not stored on our servers. However, third-party services may collect anonymized data as explained above."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="Children’s Privacy"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="This app is not intended for children under 13 (or under 16 in some jurisdictions). We do not knowingly collect personal data from children."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="Third-Party Services"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="Our app may include:\n• Google AdMob (for advertising)\n• Firebase (for analytics and crash reporting)\n• Google Play Billing for premium purchases\n\nThese services have their own privacy policies and operate independently."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_warning_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="Changes to This Policy"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We may update this Privacy Policy occasionally. Any changes will be posted on this page and, if significant, notified via the app. Continued use of the app means you accept the updated policy."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/glass_contact_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="Contact Us"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="If you have any questions about this Privacy Policy, contact us at:\nTech Nukti Media\nEmail: support@technukti.com"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
