<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_charcoal"
    tools:context=".presentation.terms_and_condition_screen_activity.TermsAndConditionActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_background_gradient" />

    <View
        android:id="@+id/glassOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.6"
        android:background="@drawable/enhanced_glass_overlay" />

    <View
        android:id="@+id/ambientGlow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:alpha="0.3"
        android:background="@drawable/ambient_glow_effect" />

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glass_content_surface"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:clickable="true"
                android:contentDescription="Back"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/warm_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:letterSpacing="0.02"
                android:text="Terms &amp; Conditions"
                android:textColor="@color/warm_white"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="true"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    android:background="@drawable/glass_info_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="Effective Date"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="September 7, 2025"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="Agreement to Terms"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text=" App Name: NotiReader\nDeveloper: Tech Nukti Media (&quot;we&quot;, &quot;our&quot;, or &quot;us&quot;)\n\nBy downloading, installing, or using NotiReader (&quot;App&quot;), you agree to be bound by the following Terms and Conditions and Privacy Policy. If you do not agree, please do not use the App."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="1. Use of the App"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.5"
                        android:text="NotiReader is a mobile application available on Android that helps users recover deleted messages through notification access. The App is provided for personal, non-commercial use only. You must be at least 13 years old (or 16 in certain jurisdictions) to use the App."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="2. Permissions and Data Collection"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="By using the App, you grant permission for the following types of data access and collection:"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="a. Notfication Access"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="To function properly, NotiReader requires access to your device’s notifications. The app may collect:"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Message content from notifications\n• Sender name\n• Timestamps"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We do not access or store messages directly from any messaging app. All processing occurs locally on your device."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="b. Device and Usage Information"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We may collect limited technical data such as:"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Device model and operating system version\n• App usage statistics\n• Crash logs"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:layout_marginBottom="12dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="This information helps improve app performance and stability."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="c. Third-Party Services"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We use trusted third-party services that may collect data used to identify you:"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="• Google AdMob – for serving personalized and contextual advertisements\n• Firebase – for analytics and crash reporting\n• Google Play Billing – to securely handle in-app purchases"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="These services may collect anonymized device data according to their respective privacy policies."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="3. In-App Purchases"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="NotiReader offers an optional premium subscription priced at ₹349/month. The premium version may provide an ad-free experience or unlock additional features. All payments are processed securely via Google Play Billing, and we do not store any payment information."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_warning_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="4. Data Security"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We take reasonable precautions to protect your data. Notification data is handled and stored locally on your device and not transmitted to our servers. However, third-party services may collect and store anonymized usage or diagnostic data."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="Children’s Privacy"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="The App is not intended for children under 13 years of age (or 16 in jurisdictions with stricter regulations). We do not knowingly collect personal information from minors. If we discover such data has been collected, it will be deleted promptly."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_warning_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="6. Your Consent"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="By using NotiReader, you consent to the collection and use of your information as outlined in this document. Your continued use of the App signifies acceptance of all terms and conditions stated herein."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/glass_section_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="7. Updates to This Policy"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="We may update this Terms and Privacy Policy periodically. Changes will be posted on this page, and significant updates may be communicated via the App. Your continued use after such changes indicates your agreement to the revised terms."
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/glass_contact_card"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:letterSpacing="0.02"
                        android:text="8. Contact Information"
                        android:textColor="@color/whatsapp_primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:lineSpacingMultiplier="1.3"
                        android:text="If you have any questions or concerns, please contact us:\nTech Nukti Media\nEmail: support@technukti.com"
                        android:textColor="@color/text_primary_dark"
                        android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
