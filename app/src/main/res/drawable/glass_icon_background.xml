<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Icon background with WhatsApp green glass effect -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1525D366" />
        </shape>
    </item>

    <!-- Frosted glass overlay -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#12F0F6FC" />
        </shape>
    </item>

    <!-- Glass reflection highlight -->
    <item
        android:top="4dp"
        android:left="4dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#20FFFFFF" />
        </shape>
    </item>
</layer-list>

