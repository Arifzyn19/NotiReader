<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base glass surface with your app's deep charcoal foundation -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A21262D" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Frosted glass overlay using your elevated surface grey -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F0D1117" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Subtle border using your WhatsApp green accent -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#2025D366" />
            <corners android:radius="20dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Inner highlight for glass reflection effect -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#15F0F6FC" />
            <corners android:radius="19dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>

